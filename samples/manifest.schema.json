{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://lazstats.local/samples/manifest.schema.json",
  "title": "LazStats sample manifest",
  "description": "Index of the datasets in samples/, generated by samples/generate.R and enforced by src/io/sampleManifest.ts.",
  "type": "object",
  "required": ["version", "generatedBy", "formats", "datasets"],
  "additionalProperties": false,
  "properties": {
    "version": { "const": 1 },
    "generatedBy": { "const": "samples/generate.R" },
    "formats": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "enum": ["csv", "sav", "dta", "xlsx", "json"] }
    },
    "datasets": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/dataset" }
    }
  },
  "definitions": {
    "dataset": {
      "type": "object",
      "required": [
        "id",
        "title",
        "family",
        "dir",
        "source",
        "rows",
        "columns",
        "formats",
        "procedures",
        "examples",
        "notes"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "title": { "type": "string", "minLength": 1 },
        "family": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "dir": { "type": "string", "minLength": 1 },
        "source": { "type": "string", "minLength": 1 },
        "rows": { "type": "integer", "minimum": 1 },
        "columns": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "formats": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["csv", "sav", "dta", "xlsx", "json"] }
        },
        "procedures": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "type": "string", "minLength": 1 }
        },
        "examples": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/example" }
        },
        "notes": { "type": "string" }
      }
    },
    "example": {
      "type": "object",
      "required": ["analysis", "columns"],
      "additionalProperties": false,
      "properties": {
        "analysis": { "type": "string", "minLength": 1 },
        "columns": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
            ]
          }
        },
        "options": {
          "type": "object",
          "additionalProperties": { "type": ["string", "number", "boolean"] }
        }
      }
    }
  }
}
