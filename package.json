{
  "name": "lazstats",
  "productName": "LazStats",
  "private": true,
  "version": "0.10.0",
  "description": "Applied statistics and reporting for the desktop",
  "author": "vigliafg",
  "license": "UNLICENSED",
  "homepage": "https://github.com/vigliafg/lazstatjs-pro",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "main": "dist-electron/main.cjs",
  "desktopName": "lazstats.desktop",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:electron": "npm run build:electron && electron . --dev",
    "build": "vite build && npm run build:electron",
    "build:web": "npm run help:build && vite build",
    "build:electron": "node scripts/build-electron.mjs",
    "start": "electron .",
    "dist": "npm run build && electron-builder --publish never",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "dist:win": "npm run build && electron-builder --win --publish never",
    "dist:mac": "npm run build && electron-builder --mac --publish never",
    "release": "npm run build && electron-builder --publish always",
    "clean": "node scripts/clean.mjs",
    "lint": "tsc --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "test:update": "UPDATE_GOLDEN=1 node --import tsx --test \"src/**/*.test.ts\"",
    "depcruise": "depcruise src --config .dependency-cruiser.cjs",
    "madge": "madge --circular --extensions ts,tsx src",
    "filesize": "node scripts/check-file-size.mjs",
    "guard": "npm run depcruise && npm run madge && npm run filesize",
    "check": "npm run lint && npm test && npm run guard",
    "test:e2e": "playwright test",
    "test:electron": "node scripts/smoke-electron.mjs",
    "test:samples": "node --import tsx --test src/io/samples.test.ts",
    "samples:generate": "Rscript samples/generate.R",
    "bench:grid": "node --import tsx scripts/bench-grid.mjs",
    "help:build": "node --import tsx scripts/build-help.mjs",
    "predev": "npm run help:build",
    "prebuild": "npm run help:build",
    "pretest": "npm run help:build",
    "postinstall": "node scripts/postinstall-electron.mjs",
    "locales:check": "node --import tsx scripts/check-locale.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@google/genai": "^1.29.0",
    "@irbisadm/statfmt": "0.1.1",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.14",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@vitejs/plugin-react": "^5.0.4",
    "autoprefixer": "^10.4.21",
    "dependency-cruiser": "^16.10.4",
    "dotenv": "^17.2.3",
    "electron": "^45.2.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.28.2",
    "express": "^4.21.2",
    "jstat": "^1.9.6",
    "lucide-react": "^0.546.0",
    "madge": "^8.0.0",
    "motion": "^12.23.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vega": "^6.4.0",
    "vega-embed": "^7.3.0",
    "vega-lite": "^6.5.0",
    "vite": "^6.2.0",
    "xlsx": "^0.18.5"
  }
}
