  {
    "id": "ts-tests",
    "title": "Test di casualità e trend",
    "columns": [
      {
        "key": "test",
        "label": "Test",
        "format": "text"
      },
      {
        "key": "statistic",
        "label": "Statistica",
        "format": "dec3"
      },
      {
        "key": "p",
        "label": "p",
        "format": "p"
      },
      {
        "key": "decision",
        "label": "Lettura",
        "format": "text"
      }
    ],
    "rows": [
      {
        "test": "Mann–Kendall (trend)",
        "statistic": -0.142728248028,
        "p": 0.886504806414,
        "decision": "nessun trend monotono"
      },
      {
        "test": "Wald–Wolfowitz (runs)",
        "statistic": 0.557417514718,
        "p": 0.577242201539,
        "decision": "compatibile con il caso"
      },
      {
        "test": "Ljung–Box (lag 1–7)",
        "statistic": 23.7472926806,
        "p": 0.00126190096518,
        "decision": "autocorrelazione presente"
      }
    ],
    "notes": [
      "Mann–Kendall è non parametrico e resistente agli outlier: p piccolo indica una tendenza monotona.",
      "Il test dei runs verifica che l’ordine dei valori sia casuale, non la loro distribuzione.",
      "Ljung–Box verifica se le prime autocorrelazioni sono congiuntamente nulle."
    ]
  },
